# ===== LLM Provider =====
# "gemini" (primary/default) or "ollama" (optional offline/dev fallback)
LLM_PROVIDER=gemini

# --- Gemini (primary) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (optional local fallback, same agent/tool architecture) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ===== RAG / Embeddings =====
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=hospital_policies

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# ===== App =====
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Data paths (synthetic, file-based persistence for this portfolio version)
DATA_DIR=./data
POLICY_DOCS_DIR=./policies
